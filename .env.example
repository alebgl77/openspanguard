# Local developer configuration. Never put real credentials in this file.
OSG_HOST=127.0.0.1
OSG_PORT=4318
OSG_EVALUATOR=disabled
OSG_ALLOW_REMOTE_CONTENT=false
OSG_OTLP_ENDPOINT=http://127.0.0.1:4319/v1/traces
OSG_EVALUATION_TIMEOUT_MS=1000
OSG_CONCURRENCY=8
OSG_MAX_QUEUE=128
OSG_CACHE_SIZE=10000
OSG_CACHE_TTL_MS=600000
OSG_COHORTS=default,demo,canary
# Set OSG_API_KEY securely when binding beyond loopback (at least 32 characters).
# Jev also requires OSG_JEV_API_KEY and OSG_ALLOW_REMOTE_CONTENT=true.
# Optional: OSG_JEV_ENDPOINT, OSG_JEV_MODEL, OSG_OTLP_AUTH.
