{
  "id": null,
  "uid": "openspanguard",
  "title": "OpenSpanGuard · Quality and coverage",
  "tags": [
    "openspanguard",
    "synthetic-demo"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Developer preview · synthetic demo",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Compose uses a deterministic synthetic scorer. These charts are not evidence of model accuracy. Run `node examples/send-demo.mjs 180` to populate rates. Inspect original traces in Explore → Tempo. Relevance is not truth; confidence is evaluator certainty; nonsense is a rubric-specific probability. Coverage excludes lost telemetry and cache guarantees are process-local."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Mean relevance",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cohort) (rate(openspanguard_quality_score_sum[5m])) / sum by (cohort) (rate(openspanguard_quality_score_count[5m]))",
          "legendFormat": "{{cohort}} {{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
