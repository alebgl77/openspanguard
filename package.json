{
  "name": "openspanguard",
  "version": "0.1.0",
  "description": "OTLP/HTTP JSON enrichment gateway for AI agent quality signals",
  "repository": { "type": "git", "url": "git+https://github.com/alebgl77/openspanguard.git" },
  "homepage": "https://alebgl77.github.io/openspanguard/",
  "bugs": { "url": "https://github.com/alebgl77/openspanguard/issues" },
  "keywords": ["opentelemetry", "otlp", "ai-agents", "evaluation", "observability", "prometheus"],
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22" },
  "main": "dist/src/index.js",
  "exports": { "./sdk": "./dist/src/sdk.js", "./server": "./dist/src/server.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/index.js",
    "test": "tsx --test test/*.test.ts",
    "demo": "tsx examples/demo.ts",
    "benchmark": "tsx examples/benchmark.ts",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "fastify": "5.12.5",
    "@prometheus-io/client": "0.16.1"
  },
  "devDependencies": {
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
